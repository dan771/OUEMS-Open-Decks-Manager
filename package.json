{
  "name": "ouems-open-decks-manager",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server/dev.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "test:browser": "playwright test",
    "demo:reset": "node scripts/reset-demo.mjs",
    "format": "prettier --write public server tests scripts *.js *.json *.jsonc *.md",
    "deploy": "wrangler deploy",
    "cf:dev": "wrangler dev --config wrangler.local.json --port 8791"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "prettier": "^3.9.9",
    "wrangler": "^4.0.0"
  }
}
